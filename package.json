{
  "name": "cosider",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:shared": "turbo run build --filter=@cosider/shared",
    "dev": "turbo run dev",
    "dev:server": "turbo run dev --filter=@cosider/server",
    "lint": "turbo run lint",
    "format": "prettier --write",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@cosider/eslint-config": "workspace:^",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "catalog:",
    "turbo": "^2.9.18",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.14.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,md,vue,html}": [
      "prettier --write"
    ]
  },
  "resolutions": {
    "nanoid": "6.0.1",
    "brace-expansion": "5.0.9",
    "js-yaml": "5.2.3",
    "postcss": "8.5.26"
  }
}
